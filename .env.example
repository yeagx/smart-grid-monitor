# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is ignored by git. Never commit it and never share it in a chat.

# AWS access key of an IAM user that can read and write the bucket (RUN_GUIDE.md, step 3)
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Where the data lake lives
AWS_REGION=eu-north-1
S3_BUCKET=sic-grad-project
